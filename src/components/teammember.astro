---
// Team Member Component
// Reusable component for displaying team members

interface Props {
  name: string;
  role: string;
  photo: string;
  bio: string;
  reversed?: boolean;
}

const { name, role, photo, bio, reversed = false } = Astro.props;
---

<div class={`team-member ${reversed ? 'reversed' : ''}`}>
  <div class="team-member-photo">
    <img src={photo} alt={name} />
  </div>
  <div class="team-member-info">
    <h3 class="team-member-name">{name}</h3>
    <p class="team-member-role">{role}</p>
    <p class="team-member-bio">{bio}</p>
  </div>
</div>