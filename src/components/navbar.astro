---
// Navigation Component
// Reusable navigation bar for all pages in the Serra 2.0 project
import '../styles/global.css';

interface Props {
  currentPage?: string;
}

const { currentPage = 'home' } = Astro.props;

// Base URL for GitHub Pages
const baseUrl = '/serra2';

// About dropdown menu items
const aboutMenuItems = [
{ title: 'No babe art', href: `${baseUrl}/about/no-babe-art` },
{ title: 'Control and Righteousness', href: `${baseUrl}/about/control-and-righteousness` },
{ title: 'The four artists', href: `${baseUrl}/about/the-four-artists-of-the-regular-editions` },
{ title: 'An Iberian missprint', href: `${baseUrl}/about/an-iberian-missprint` },
{ title: 'Our Team', href: `${baseUrl}/about/our-team` },
];
---

<!-- Navigation Bar -->
<nav>
  <div class="nav-container">
    <a href="/serra2" class="nav-logo">Serra 2.0</a>
    <button class="menu-toggle" id="menuToggle">☰</button>
    <div class="nav-buttons" id="navButtons">
      
      <!-- About Dropdown Menu -->
      <div class="nav-dropdown">
        <button class="nav-btn dropdown-toggle" id="aboutDropdown">
          About
          <span class="dropdown-arrow">▼</span>
        </button>
        <div class="dropdown-menu" id="aboutMenu">
          {aboutMenuItems.map(item => (
            <a href={item.href} class="dropdown-item">{item.title}</a>
          ))}
        </div>
      </div>

      <a href={`${baseUrl}/artists/`} class="nav-btn" data-page="artists">Artists</a>
      <a href={`${baseUrl}/expositions/`} class="nav-btn">Expositions</a>
      <a href={`${baseUrl}/partners/`} class="nav-btn">Partners</a>
      <a href={`${baseUrl}/participate/`} class="nav-btn">Participate</a>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle functionality
  const menuToggle = document.getElementById('menuToggle');
  const navButtons = document.getElementById('navButtons');

  if (menuToggle && navButtons) {
    menuToggle.addEventListener('click', () => {
      navButtons.classList.toggle('active');
    });

    // Close mobile menu when clicking a link
    const navLinks = document.querySelectorAll('.nav-btn:not(.dropdown-toggle), .dropdown-item');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        navButtons.classList.remove('active');
      });
    });
  }

  // Dropdown menu functionality
  const aboutDropdown = document.getElementById('aboutDropdown');
  const aboutMenu = document.getElementById('aboutMenu');

  if (aboutDropdown && aboutMenu) {
    // Toggle dropdown on click
    aboutDropdown.addEventListener('click', (e) => {
      e.stopPropagation();
      aboutDropdown.classList.toggle('active');
      aboutMenu.classList.toggle('show');
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!aboutDropdown.contains(e.target as Node) && !aboutMenu.contains(e.target as Node)) {
        aboutDropdown.classList.remove('active');
        aboutMenu.classList.remove('show');
      }
    });

    // Close dropdown when clicking a dropdown item
    const dropdownItems = aboutMenu.querySelectorAll('.dropdown-item');
    dropdownItems.forEach(item => {
      item.addEventListener('click', () => {
        aboutDropdown.classList.remove('active');
        aboutMenu.classList.remove('show');
      });
    });
  }

  // Smooth scrolling for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      e.preventDefault();
      const href = anchor.getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      }
    });
  });
</script>