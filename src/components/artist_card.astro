---
// Artist Card Component
// Compact card that links to individual artist pages

interface Props {
  name: string;
  photo: string;
  slug: string; // URL-friendly version of name (e.g., "artist-name-1")
}

const { name, photo, slug } = Astro.props;

// Base URL for GitHub Pages
const baseUrl = '/serra2';
---

<a href={`${baseUrl}/artists/${slug}`} class="artist-card-link">
  <div class="artist-card-compact">
    <div class="artist-photo">
      <img src={photo} alt={name} />
    </div>
    <h3 class="artist-card-name">{name}</h3>
  </div>
</a>