---
// Serra 2.0 Landing Page
// Main landing page for the art project inspired by Serra Angel from Magic the Gathering

// Import the global stylesheet
import '../styles/global.css';

// Import the reusable Navigation component
import Navigation from '../components/navbar.astro';

// Page metadata
const pageTitle = "Serra 2.0 - Reimagining Serra Angel";
const pageDescription = "An art project celebrating Serra Angel through contemporary artistic interpretations";

// Featured artists data - easily maintainable array
const artists = [
  {
    name: "Artist Name 1",
    specialty: "Digital Illustration",
    image: "/artists/artist1.jpg" // Replace with actual image paths
  },
  {
    name: "Artist Name 2",
    specialty: "Traditional Painting",
    image: "/artists/artist2.jpg"
  },
  {
    name: "Artist Name 3",
    specialty: "3D Sculpture",
    image: "/artists/artist3.jpg"
  }
];

// Featured artworks data
const artworks = [
  {
    title: "Artwork Title 1",
    artist: "Artist Name 1",
    image: "/artworks/work1.jpg",
    description: "Brief description of the artwork"
  },
  {
    title: "Artwork Title 2",
    artist: "Artist Name 2",
    image: "/artworks/work2.jpg",
    description: "Brief description of the artwork"
  },
  {
    title: "Artwork Title 3",
    artist: "Artist Name 3",
    image: "/artworks/work3.jpg",
    description: "Brief description of the artwork"
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <title>{pageTitle}</title>
</head>

<body>
  <!-- Import Navigation Component -->
  <Navigation currentPage="home" />

  <!-- Hero Section - Main introduction to the project -->
  <section class="hero" id="home">
    <div class="hero-content">
      <h1>Serra 2.0</h1>
      <p>A contemporary reimagining of the iconic Serra Angel through the eyes of diverse artists</p>
    </div>
  </section>

  <!-- About Section - Project description -->
  <section class="about" id="about">
    <div class="container">
      <h2 class="section-title">About the Project</h2>
      <div class="about-content">
        <p>
          Serra 2.0 is an artistic tribute to one of Magic: The Gathering's most beloved creatures, 
          Serra Angel. This project brings together talented artists from various disciplines to 
          reinterpret this iconic card through modern artistic lenses, celebrating both the original's 
          legacy and the endless possibilities of creative expression.
        </p>
        <p style="margin-top: 1rem;">
          Each piece in this collection offers a unique perspective, from traditional painting to 
          digital illustration and three-dimensional sculpture, united by their reverence for the 
          source material and their bold artistic vision.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Artists Section -->
  <section class="artists" id="artists">
    <div class="container">
      <h2 class="section-title">Featured Artists</h2>
      <div class="artists-grid">
        {artists.map((artist) => (
          <div class="artist-card">
            <div class="artist-image">
              <!-- Replace with actual image: <img src={artist.image} alt={artist.name} /> -->
              Artist Photo
            </div>
            <div class="artist-info">
              <h3 class="artist-name">{artist.name}</h3>
              <p class="artist-specialty">{artist.specialty}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Artworks Section -->
  <section class="artworks" id="artworks">
    <div class="container">
      <h2 class="section-title">Featured Artworks</h2>
      <div class="artworks-grid">
        {artworks.map((artwork) => (
          <div class="artwork-card">
            <div class="artwork-image">
              <!-- Replace with actual image: <img src={artwork.image} alt={artwork.title} /> -->
              Artwork Preview
            </div>
            <div class="artwork-details">
              <h3 class="artwork-title">{artwork.title}</h3>
              <p class="artwork-artist">by {artwork.artist}</p>
              <p class="artwork-description">{artwork.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 Serra 2.0 Project. All rights reserved.</p>
  </footer>
</body>
</html>
</html>