---
// Serra 2.0 Landing Page
// Main landing page for the art project inspired by Serra Angel from Magic the Gathering

// Import the reusable Navigation component and global styles
import '../styles/global.css';
import Navigation from '../components/navbar.astro';

// Page metadata
const pageTitle = "Serra 2.0 - Reimagining Serra Angel";
const pageDescription = "An art project celebrating Serra Angel through contemporary artistic interpretations";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <title>{pageTitle}</title>
</head>

<body>
  <!-- Import Navigation Component -->
  <Navigation currentPage="home" />

  <!-- Hero Section - Main introduction to the project -->
  <section class="hero" id="home">
    <div class="hero-content">
      <h1>Serra 2.0</h1>
      <p>A contemporary reimagining of the iconic Serra Angel through the eyes of diverse artists</p>
    </div>
  </section>

  <!-- About Section - Project description -->
  <section class="about" id="about">
    <div class="container">
      <h2 class="section-title">About the Project</h2>
      <div class="about-content">
        <p>
          Serra 2.0 is an artistic tribute to one of Magic: The Gathering's most beloved creatures, 
          Serra Angel. This project brings together talented artists from various disciplines to 
          reinterpret this iconic card through modern artistic lenses, celebrating both the original's 
          legacy and the endless possibilities of creative expression.
        </p>
        <p style="margin-top: 1rem;">
          Each piece in this collection offers a unique perspective, from traditional painting to 
          digital illustration and three-dimensional sculpture, united by their reverence for the 
          source material and their bold artistic vision.
        </p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 Serra 2.0 Project. All rights reserved.</p>
  </footer>
</body>
</html>
</html>