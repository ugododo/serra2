---
// Partners Page
// Displays all partners and sponsors of the Serra 2.0 project
// Place this file in: src/pages/partners.astro

// Import the reusable Navigation component
import Navigation from '../components/navbar.astro';

// Page metadata
const pageTitle = "Partners - Serra 2.0";
const pageDescription = "Our valued partners and sponsors supporting the Serra 2.0 art project";

// Partners data - Easy to maintain array
// Simply add new objects to this array to add new partners
// Logo images should be placed in the /public/partners/ folder
const partners = [
  {
    name: "Gallery Modern Art",
    logo: "/partners/partner1.png", // Replace with actual logo path
    website: "https://example.com/partner1",
    category: "gallery" // gallery, sponsor, media, or supporter
  },
  {
    name: "Art Foundation Paris",
    logo: "/partners/partner2.png",
    website: "https://example.com/partner2",
    category: "sponsor"
  },
  {
    name: "Creative Magazine",
    logo: "/partners/partner3.png",
    website: "https://example.com/partner3",
    category: "media"
  },
  {
    name: "Cultural Association",
    logo: "/partners/partner4.png",
    website: "https://example.com/partner4",
    category: "supporter"
  },
  {
    name: "Art Supplies Co",
    logo: "/partners/partner5.png",
    website: "https://example.com/partner5",
    category: "sponsor"
  },
  {
    name: "City Gallery Network",
    logo: "/partners/partner6.png",
    website: "https://example.com/partner6",
    category: "gallery"
  }
];

// Separate partners by category
const galleries = partners.filter(p => p.category === 'gallery');
const sponsors = partners.filter(p => p.category === 'sponsor');
const mediaPartners = partners.filter(p => p.category === 'media');
const supporters = partners.filter(p => p.category === 'supporter');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <title>{pageTitle}</title>
  
  <style>
    /* CSS Reset and Base Styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      line-height: 1.6;
      color: #333;
      background: #f9f9f9;
      padding-top: 80px; /* Account for fixed navigation */
    }

    /* Page header */
    .page-header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 4rem 2rem 3rem;
      text-align: center;
    }

    .page-header h1 {
      font-size: clamp(2.5rem, 6vw, 4rem);
      margin-bottom: 1rem;
    }

    .page-header p {
      font-size: 1.2rem;
      opacity: 0.95;
      max-width: 700px;
      margin: 0 auto;
    }

    /* Container for content sections */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 2rem;
    }

    /* Section styling */
    .partner-section {
      margin-bottom: 4rem;
    }

    .section-title {
      font-size: 2rem;
      color: #2c3e50;
      margin-bottom: 2rem;
      padding-bottom: 0.5rem;
      border-bottom: 3px solid #667eea;
    }

    /* Partners grid - responsive layout */
    .partners-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 2rem;
    }

    /* Partner card */
    .partner-card {
      background: white;
      border-radius: 12px;
      padding: 2rem;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      text-decoration: none;
      color: inherit;
    }

    .partner-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 12px rgba(0,0,0,0.15);
    }

    /* Partner logo container */
    .partner-logo {
      width: 100%;
      height: 150px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      background: #f8f9fa;
      border-radius: 8px;
      padding: 1rem;
    }

    .partner-logo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    /* Placeholder for missing logos */
    .partner-logo-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      font-size: 1.2rem;
      font-weight: 600;
      border-radius: 8px;
    }

    /* Partner name */
    .partner-name {
      font-size: 1.3rem;
      font-weight: 700;
      color: #2c3e50;
      margin-bottom: 1rem;
    }

    /* Visit website button */
    .partner-link {
      margin-top: auto;
      padding: 0.6rem 1.5rem;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      text-decoration: none;
      border-radius: 25px;
      font-weight: 600;
      transition: opacity 0.3s ease;
      display: inline-block;
    }

    .partner-link:hover {
      opacity: 0.9;
    }

    /* Empty state message */
    .empty-message {
      text-align: center;
      padding: 3rem 2rem;
      color: #7f8c8d;
      font-size: 1.1rem;
    }

    /* Thank you section */
    .thank-you {
      background: white;
      border-radius: 12px;
      padding: 3rem 2rem;
      text-align: center;
      margin-top: 3rem;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .thank-you h2 {
      font-size: 2rem;
      color: #2c3e50;
      margin-bottom: 1rem;
    }

    .thank-you p {
      font-size: 1.1rem;
      color: #555;
      max-width: 700px;
      margin: 0 auto;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      .partners-grid {
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      }

      .page-header {
        padding: 3rem 1.5rem 2rem;
      }

      .container {
        padding: 2rem 1.5rem;
      }
    }
  </style>
</head>

<body>
  <!-- Import Navigation Component -->
  <Navigation currentPage="partners" />

  <!-- Page Header -->
  <header class="page-header">
    <h1>Our Partners</h1>
    <p>We're grateful to work with these amazing organizations that support the Serra 2.0 project</p>
  </header>

  <!-- Main Content -->
  <main class="container">
    
    <!-- Gallery Partners -->
    {galleries.length > 0 && (
      <section class="partner-section">
        <h2 class="section-title">Gallery Partners</h2>
        <div class="partners-grid">
          {galleries.map((partner) => (
            <a href={partner.website} target="_blank" rel="noopener noreferrer" class="partner-card">
              <div class="partner-logo">
                <!-- Replace placeholder with actual logo when available -->
                <div class="partner-logo-placeholder">
                  {partner.name.split(' ').map(word => word[0]).join('')}
                </div>
                <!-- Uncomment when logos are available:
                <img src={partner.logo} alt={partner.name} />
                -->
              </div>
              <h3 class="partner-name">{partner.name}</h3>
              <span class="partner-link">Visit Website →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Sponsors -->
    {sponsors.length > 0 && (
      <section class="partner-section">
        <h2 class="section-title">Sponsors</h2>
        <div class="partners-grid">
          {sponsors.map((partner) => (
            <a href={partner.website} target="_blank" rel="noopener noreferrer" class="partner-card">
              <div class="partner-logo">
                <div class="partner-logo-placeholder">
                  {partner.name.split(' ').map(word => word[0]).join('')}
                </div>
              </div>
              <h3 class="partner-name">{partner.name}</h3>
              <span class="partner-link">Visit Website →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Media Partners -->
    {mediaPartners.length > 0 && (
      <section class="partner-section">
        <h2 class="section-title">Media Partners</h2>
        <div class="partners-grid">
          {mediaPartners.map((partner) => (
            <a href={partner.website} target="_blank" rel="noopener noreferrer" class="partner-card">
              <div class="partner-logo">
                <div class="partner-logo-placeholder">
                  {partner.name.split(' ').map(word => word[0]).join('')}
                </div>
              </div>
              <h3 class="partner-name">{partner.name}</h3>
              <span class="partner-link">Visit Website →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Supporters -->
    {supporters.length > 0 && (
      <section class="partner-section">
        <h2 class="section-title">Supporters</h2>
        <div class="partners-grid">
          {supporters.map((partner) => (
            <a href={partner.website} target="_blank" rel="noopener noreferrer" class="partner-card">
              <div class="partner-logo">
                <div class="partner-logo-placeholder">
                  {partner.name.split(' ').map(word => word[0]).join('')}
                </div>
              </div>
              <h3 class="partner-name">{partner.name}</h3>
              <span class="partner-link">Visit Website →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Empty state - if no partners exist -->
    {partners.length === 0 && (
      <div class="empty-message">
        <p>Partner information coming soon!</p>
      </div>
    )}

    <!-- Thank you section -->
    {partners.length > 0 && (
      <section class="thank-you">
        <h2>Thank You</h2>
        <p>
          We extend our heartfelt gratitude to all our partners for their invaluable support 
          in making the Serra 2.0 project a reality. Together, we celebrate art and creativity.
        </p>
      </section>
    )}

  </main>

  <!-- Footer -->
  <footer style="background: #2c3e50; color: white; text-align: center; padding: 2rem;">
    <p>&copy; 2026 Serra 2.0 Project. All rights reserved.</p>
  </footer>
</body>
</html>