---
// Partners Page
// Displays all partners and sponsors of the Serra 2.0 project

// Import the global stylesheet
import '../styles/global.css';

// Import the reusable Navigation component
import Navigation from '../components/navbar.astro';

// Page metadata
const pageTitle = "Partners - Serra 2.0";
const pageDescription = "Our valued partners and sponsors supporting the Serra 2.0 art project";

// Partners data - Easy to maintain array
// Simply add new objects to this array to add new partners
// Logo images should be placed in the /public/partners/ folder
const partners = [
  {
    name: "Gallery Modern Art",
    logo: "/partners/partner1.png", // Replace with actual logo path
    website: "https://example.com/partner1",
    category: "gallery" // gallery, sponsor, media, or supporter
  },
  {
    name: "Art Foundation Paris",
    logo: "/partners/partner2.png",
    website: "https://example.com/partner2",
    category: "sponsor"
  },
  {
    name: "Creative Magazine",
    logo: "/partners/partner3.png",
    website: "https://example.com/partner3",
    category: "media"
  },
  {
    name: "Cultural Association",
    logo: "/partners/partner4.png",
    website: "https://example.com/partner4",
    category: "supporter"
  },
  {
    name: "Art Supplies Co",
    logo: "/partners/partner5.png",
    website: "https://example.com/partner5",
    category: "sponsor"
  },
  {
    name: "City Gallery Network",
    logo: "/partners/partner6.png",
    website: "https://example.com/partner6",
    category: "gallery"
  }
];

// Separate partners by category
const galleries = partners.filter(p => p.category === 'gallery');
const sponsors = partners.filter(p => p.category === 'sponsor');
const mediaPartners = partners.filter(p => p.category === 'media');
const supporters = partners.filter(p => p.category === 'supporter');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <title>{pageTitle}</title>
</head>

<body>
  <!-- Import Navigation Component -->
  <Navigation currentPage="partners" />

  <!-- Page Header -->
  <header class="page-header">
    <h1>Our Partners</h1>
    <p>We're grateful to work with these amazing organizations that support the Serra 2.0 project</p>
  </header>

  <!-- Main Content -->
  <main class="container">
    
    <!-- Gallery Partners -->
    {galleries.length > 0 && (
      <section class="partner-section">
        <h2 class="section-title">Gallery Partners</h2>
        <div class="partners-grid">
          {galleries.map((partner) => (
            <a href={partner.website} target="_blank" rel="noopener noreferrer" class="partner-card">
              <div class="partner-logo">
                <!-- Replace placeholder with actual logo when available -->
                <div class="partner-logo-placeholder">
                  {partner.name.split(' ').map(word => word[0]).join('')}
                </div>
                <!-- Uncomment when logos are available:
                <img src={partner.logo} alt={partner.name} />
                -->
              </div>
              <h3 class="partner-name">{partner.name}</h3>
              <span class="partner-link">Visit Website →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Sponsors -->
    {sponsors.length > 0 && (
      <section class="partner-section">
        <h2 class="section-title">Sponsors</h2>
        <div class="partners-grid">
          {sponsors.map((partner) => (
            <a href={partner.website} target="_blank" rel="noopener noreferrer" class="partner-card">
              <div class="partner-logo">
                <div class="partner-logo-placeholder">
                  {partner.name.split(' ').map(word => word[0]).join('')}
                </div>
              </div>
              <h3 class="partner-name">{partner.name}</h3>
              <span class="partner-link">Visit Website →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Media Partners -->
    {mediaPartners.length > 0 && (
      <section class="partner-section">
        <h2 class="section-title">Media Partners</h2>
        <div class="partners-grid">
          {mediaPartners.map((partner) => (
            <a href={partner.website} target="_blank" rel="noopener noreferrer" class="partner-card">
              <div class="partner-logo">
                <div class="partner-logo-placeholder">
                  {partner.name.split(' ').map(word => word[0]).join('')}
                </div>
              </div>
              <h3 class="partner-name">{partner.name}</h3>
              <span class="partner-link">Visit Website →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Supporters -->
    {supporters.length > 0 && (
      <section class="partner-section">
        <h2 class="section-title">Supporters</h2>
        <div class="partners-grid">
          {supporters.map((partner) => (
            <a href={partner.website} target="_blank" rel="noopener noreferrer" class="partner-card">
              <div class="partner-logo">
                <div class="partner-logo-placeholder">
                  {partner.name.split(' ').map(word => word[0]).join('')}
                </div>
              </div>
              <h3 class="partner-name">{partner.name}</h3>
              <span class="partner-link">Visit Website →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Empty state - if no partners exist -->
    {partners.length === 0 && (
      <div class="empty-message">
        <p>Partner information coming soon!</p>
      </div>
    )}

    <!-- Thank you section -->
    {partners.length > 0 && (
      <section class="thank-you">
        <h2>Thank You</h2>
        <p>
          We extend our heartfelt gratitude to all our partners for their invaluable support 
          in making the Serra 2.0 project a reality. Together, we celebrate art and creativity.
        </p>
      </section>
    )}

  </main>

  <!-- Footer -->
  <footer style="background: #2c3e50; color: white; text-align: center; padding: 2rem;">
    <p>&copy; 2026 Serra 2.0 Project. All rights reserved.</p>
  </footer>
</body>
</html>