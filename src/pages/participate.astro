---
// Participate Page
// Page for artists to access participation documents and guidelines
// Place this file in: src/pages/participate.astro

// Import components
import '../styles/global.css';
import Navigation from '../components/navbar.astro';

// Page metadata
const pageTitle = "Participate - Serra 2.0";
const pageDescription = "Join the Serra 2.0 project - Access participation guidelines and application forms";

// Documents data - Easy to maintain
// To add a new document: add an object here with title, description, and Google Drive link
// Make sure your Google Drive links are set to "Anyone with the link can view"
const documents = [
  {
    title: "Participation Guidelines",
    description: "Complete guidelines for artists interested in joining the Serra 2.0 project, including theme details and requirements.",
    icon: "📋",
    link: "https://drive.google.com/" // Replace with your Google Drive link
  },
  {
    title: "Application Form",
    description: "Download and complete this form to submit your application to participate in the project.",
    icon: "📝",
    link: "https://drive.google.com/" // Replace with your Google Drive link
  },
  {
    title: "Technical Specifications",
    description: "Artwork specifications, file formats, dimensions, and submission requirements.",
    icon: "🎨",
    link: "https://drive.google.com" // Replace with your Google Drive link
  },
  {
    title: "Terms & Conditions",
    description: "Legal terms, copyright agreements, and conditions for participating artists.",
    icon: "📄",
    link: "https://drive.google.com/" // Replace with your Google Drive link
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <title>{pageTitle}</title>
</head>

<body>
  <!-- Import Navigation Component -->
  <Navigation currentPage="participate" />

  <!-- Page Header -->
  <header class="page-header">
    <h1>Participate in Serra 2.0</h1>
    <p>Join us in reimagining the iconic Serra Angel. Download the documents below to get started.</p>
  </header>

  <!-- Main Content -->
  <main class="container">
    
    <!-- Introduction Section -->
    <section class="participate-intro">
      <h2>We're Looking for Artists!</h2>
      <p>
        The Serra 2.0 project welcomes talented artists from all disciplines to contribute their unique 
        interpretations of Serra Angel. Whether you work in digital art, traditional painting, sculpture, 
        or any other medium, we'd love to see your vision.
      </p>
      <p>
        Please review all documents below carefully before submitting your application. If you have any 
        questions, feel free to reach out via our contact page.
      </p>
    </section>

    <!-- Documents Grid -->
    <section class="participate-documents">
      <h2 class="section-title">Required Documents</h2>
      <div class="documents-grid">
        {documents.map((doc) => (
          <a href={doc.link} target="_blank" rel="noopener noreferrer" class="document-card">
            <div class="document-icon">{doc.icon}</div>
            <h3 class="document-title">{doc.title}</h3>
            <p class="document-description">{doc.description}</p>
            <span class="document-button">View Document →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section class="participate-cta">
      <h2>Ready to Apply?</h2>
      <p>
        Once you've reviewed all the documents, complete the application form and submit your portfolio. 
        We look forward to seeing your creative interpretation of Serra Angel!
      </p>
    </section>

  </main>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 Serra 2.0 Project. All rights reserved.</p>
  </footer>
</body>
</html>