---
// Individual Artist Detail Page
// Create one file for each artist in: src/pages/artists/[artist-slug].astro
// Example: src/pages/artists/artist-name-1.astro

// Import components
import '../../styles/global.css';
import Navigation from '../../components/navbar.astro';

// Base URL for GitHub Pages
const baseUrl = '/serra2';

// Artist data - Update this for each artist
const artist = {
  name: "Véronique Meignaud",
  bio: "Véronique Meignaud is a French-Canadian multidisciplinary artist based in France. She specializes in concept art and illustration for the video game and board game industries. She is also involved in visual development and art direction for multimedia performances and immersive experiences. Trained in the arts at the École Émile Cohl in Lyon in 2004, she later earned a diploma in Floristry in Montreal in 2018. She founded Veloutier to explore vegetal scenography through projects such as book cover illustrations, stamp designs for Canada Post, and artistic collaborations on photographic shoots. Contact: veronique_meignaud on Instagram https://www.meignaud.com/",
  artworks: [
    {
      title: "Artwork Title 1",
      image: ``,
      description: "A detailed description of this artwork, the concept behind it, and what makes it special."
    },
    {
      title: "Artwork Title 2",
      image: ``,
      description: "A detailed description of this artwork, the concept behind it, and what makes it special."
    },
    {
      title: "Artwork Title 3",
      image: "/artworks/artist1-work3.jpg",
      description: "A detailed description of this artwork, the concept behind it, and what makes it special."
    }
  ]
};

// Page metadata
const pageTitle = `${artist.name} - Serra 2.0`;
const pageDescription = `Explore ${artist.name}'s artworks for the Serra 2.0 project`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <title>{pageTitle}</title>
</head>

<body>
  <!-- Import Navigation Component -->
  <Navigation currentPage="artists" />

  <!-- Artist Header -->
  <header class="artist-detail-header">
    <div class="container">
      <a href={`${baseUrl}/artists/`} class="back-link">← Back to Artists</a>
      <h1 class="artist-detail-name">{artist.name}</h1>
      <p class="artist-detail-bio">{artist.bio}</p>
    </div>
  </header>

  <!-- Artworks Section -->
  <main class="container">
    <h2 class="section-title">Artworks</h2>
    <div class="artist-detail-artworks-grid">
      {artist.artworks.map((artwork) => (
        <div class="artist-detail-artwork-card">
          <div class="artist-detail-artwork-image">
            <img src={artwork.image} alt={artwork.title} />
          </div>
          <div class="artist-detail-artwork-info">
            <h3 class="artist-detail-artwork-title">{artwork.title}</h3>
            <p class="artist-detail-artwork-description">{artwork.description}</p>
          </div>
        </div>
      ))}
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 Serra 2.0 Project. All rights reserved.</p>
  </footer>
</body>
</html>