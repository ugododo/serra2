---
// Individual Artist Detail Page
// Create one file for each artist in: src/pages/artists/[artist-slug].astro
// Example: src/pages/artists/artist-name-1.astro

// Import components
import '../../styles/global.css';
import Navigation from '../../components/navbar.astro';

// Artist data - Update this for each artist
const artist = {
  name: "Amber Cartel",
  bio: "Amber-Rose Hulme is an Australian photo realist artist who primarily worked on large scale, soft pastel pieces, depicting the graffiti laden and textured laneways of Melbourne. Her collection of works also included a selection od self portraits. In 2025 she translated her photorealistic approach to works on a very small scale, becoming a major Alter Artist of Magic the Gathering and TCG cards with thousands of followers. Contact: jay.alters on Instagram",
  artworks: [
    {
      title: "Artwork Title 1",
      image: "/artists-artworks/AmberCartelCard.jpg",
      description: "A detailed description of this artwork, the concept behind it, and what makes it special."
    },
    {
      title: "Artwork Title 2",
      image: "artists-artworks/AmberCartelFramed.jpg",
      description: "A detailed description of this artwork, the concept behind it, and what makes it special."
    },
  ]
};

// Page metadata
const pageTitle = `${artist.name} - Serra 2.0`;
const pageDescription = `Explore ${artist.name}'s artworks for the Serra 2.0 project`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <title>{pageTitle}</title>
</head>

<body>
  <!-- Import Navigation Component -->
  <Navigation currentPage="artists" />

  <!-- Artist Header -->
  <header class="artist-detail-header">
    <div class="container">
      <a href="/artists" class="back-link">← Back to Artists</a>
      <h1 class="artist-detail-name">{artist.name}</h1>
      <p class="artist-detail-bio">{artist.bio}</p>
    </div>
  </header>

  <!-- Artworks Section -->
  <main class="container">
    <h2 class="section-title">Artworks</h2>
    <div class="artist-detail-artworks-grid">
      {artist.artworks.map((artwork) => (
        <div class="artist-detail-artwork-card">
          <div class="artist-detail-artwork-image">
            <img src={artwork.image} alt={artwork.title} />
          </div>
          <div class="artist-detail-artwork-info">
            <h3 class="artist-detail-artwork-title">{artwork.title}</h3>
            <p class="artist-detail-artwork-description">{artwork.description}</p>
          </div>
        </div>
      ))}
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 Serra 2.0 Project. All rights reserved.</p>
  </footer>
</body>
</html>

<style>
  /* Artist Detail Header */
  .artist-detail-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 6rem 2rem 4rem;
  }

  .back-link {
    color: white;
    text-decoration: none;
    font-size: 1rem;
    opacity: 0.9;
    transition: opacity 0.3s ease;
    display: inline-block;
    margin-bottom: 2rem;
  }

  .back-link:hover {
    opacity: 1;
  }

  .artist-detail-name {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 2rem;
    font-weight: 700;
  }

  .artist-detail-bio {
    font-size: 1.2rem;
    line-height: 1.8;
    max-width: 800px;
    opacity: 0.95;
  }

  /* Artworks Grid */
  .artist-detail-artworks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2.5rem;
    margin-top: 2rem;
    padding-bottom: 4rem;
  }

  .artist-detail-artwork-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .artist-detail-artwork-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 12px rgba(0,0,0,0.15);
  }

  .artist-detail-artwork-image {
    width: 100%;
    height: 400px;
    overflow: hidden;
    position: relative;
  }

  .artist-detail-artwork-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .artist-detail-artwork-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.3rem;
    font-weight: 600;
    padding: 2rem;
    text-align: center;
  }

  .artist-detail-artwork-info {
    padding: 2rem;
  }

  .artist-detail-artwork-title {
    font-size: 1.6rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 1rem;
  }

  .artist-detail-artwork-description {
    color: #666;
    line-height: 1.8;
    font-size: 1.05rem;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .artist-detail-header {
      padding: 5rem 1.5rem 3rem;
    }

    .artist-detail-artworks-grid {
      grid-template-columns: 1fr;
    }
  }
</style>