---
// Expositions Page
// Displays all upcoming and past exhibitions/representations of the Serra 2.0 project

import '../styles/global.css';
import Navigation from '../components/navbar.astro';

// Page metadata
const pageTitle = "Expositions - Serra 2.0";
const pageDescription = "Upcoming and past exhibitions of the Serra 2.0 art project";

// Base URL for GitHub Pages
const baseUrl = '/serra2';

// Simply add new objects to this array to add new expositions
// status is upcoming, ongoing, or past
// photos is optional - array of photo filenames stored in /public/expositions/
const expositions = [
  {
    name: "Phoenix Limited Championship 6",
    address: "CentraleSupélec, Bâtiment Eiffel, 8 Rue Joliot Curie, 91190 Gif-sur-Yvette",
    startDate: "2026-02-08",
    endDate: "2026-02-08",
    website: "https://pots.lydia.me/collect/phoenix-limited-championship-9923265/fr",
    status: "past",
  },  
  {
    name: "Magic Mania Lille",
    address: "59000 Lille, France",
    startDate: "2026-05-08",
    endDate: "2026-05-11",
    website: "https://www.garage-les-lillois.fr/magic-mania-lille/",
    status: "past",
    photos: ["MagicMania1.jpg", "MagicMania2.jpg", "MagicMania3.jpg", "MagicMania4.jpg", "MagicMania5.jpg", "MagicMania6.jpg",
      "MagicMania7.jpg", "MagicMania8.jpg", "MagicMania9.jpg", "MagicMania10.jpg", "MagicMania11.jpg", "MagicMania12.jpg", "MagicMania13.jpg"]
  },
  {
    name: "Play-in BNF",
    address: "131 Av. de France, 75013 Paris",
    startDate: "2026-03-06",
    endDate: "2026",
    website: "https://www.play-in.com/en/magasin/1/paris-bnf",
    status: "past",
    photos: ["play-in-panorama1.jpg", "play-in-closeup1.jpg", "play-in-panorama2.jpg", "play-in-closeup2.jpg"]
  }
];

// Helper function to format dates
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
}

// Separate expositions by status
const upcomingExpositions = expositions.filter(exp => exp.status === 'upcoming');
const ongoingExpositions = expositions.filter(exp => exp.status === 'ongoing');
const pastExpositions = expositions.filter(exp => exp.status === 'past');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <title>{pageTitle}</title>
</head>

<body>
  <Navigation currentPage="expositions" />

  <header class="page-header">
    <h1>Expositions</h1>
    <p>Discover where you can experience the Serra 2.0 art project in person</p>
  </header>

  <main class="container">
    
    <!-- Ongoing Expositions -->
    {ongoingExpositions.length > 0 && (
      <section class="expo-section">
        <h2 class="section-title">Currently On Display</h2>
        <div class="expo-grid">
          {ongoingExpositions.map((expo) => (
            <article class="expo-card">
              <span class="status-badge ongoing">Ongoing</span>
              
              {/* Photo Gallery */}
              {expo.photos && expo.photos.length > 0 && (
                <div class="expo-photos">
                  {expo.photos.length === 1 ? (
                    <div 
                      class="expo-photo-single js-lightbox-trigger"
                      data-lightbox-src={`${baseUrl}/expositions/${expo.photos[0]}`}
                      data-lightbox-caption={`${expo.name} - Exhibition Photo`}
                    >
                      <img 
                        src={`${baseUrl}/expositions/${expo.photos[0]}`} 
                        alt={`${expo.name} exhibition`}
                      />
                      <div class="zoom-overlay"></div>
                    </div>
                  ) : (
                    <div class={`expo-photo-gallery photos-${expo.photos.length}`}>
                      {expo.photos.map((photo, index) => (
                        <div 
                          class="expo-photo-wrapper js-lightbox-trigger"
                          data-lightbox-src={`${baseUrl}/expositions/${photo}`}
                          data-lightbox-caption={`${expo.name} - Photo ${index + 1}`}
                        >
                          <img 
                            src={`${baseUrl}/expositions/${photo}`} 
                            alt={`${expo.name} exhibition photo ${index + 1}`}
                            class="expo-photo-grid"
                          />
                          <div class="zoom-overlay"></div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}
              
              <h3 class="expo-name">{expo.name}</h3>
              
              <div class="expo-detail">
                <span class="expo-detail-icon">📍</span>
                <span class="expo-detail-text">{expo.address}</span>
              </div>
              
              <div class="expo-detail">
                <span class="expo-detail-icon">📅</span>
                <span class="expo-detail-text">
                  <span class="expo-dates">
                    {formatDate(expo.startDate)} - {formatDate(expo.endDate)}
                  </span>
                </span>
              </div>
              
              {expo.website && (
                <a href={expo.website} target="_blank" rel="noopener noreferrer" class="expo-button">
                  Visit Website →
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    {upcomingExpositions.length > 0 && (
      <section class="expo-section">
        <h2 class="section-title">Upcoming Expositions</h2>
        <div class="expo-grid">
          {upcomingExpositions.map((expo) => (
            <article class="expo-card">
              <span class="status-badge upcoming">Upcoming</span>
              
              {/* Photo Gallery */}
              {expo.photos && expo.photos.length > 0 && (
                <div class="expo-photos">
                  {expo.photos.length === 1 ? (
                    <div 
                      class="expo-photo-single js-lightbox-trigger"
                      data-lightbox-src={`${baseUrl}/expositions/${expo.photos[0]}`}
                      data-lightbox-caption={`${expo.name} - Exhibition Photo`}
                    >
                      <img 
                        src={`${baseUrl}/expositions/${expo.photos[0]}`} 
                        alt={`${expo.name} exhibition`}
                      />
                      <div class="zoom-overlay"></div>
                    </div>
                  ) : (
                    <div class={`expo-photo-gallery photos-${expo.photos.length}`}>
                      {expo.photos.map((photo, index) => (
                        <div 
                          class="expo-photo-wrapper js-lightbox-trigger"
                          data-lightbox-src={`${baseUrl}/expositions/${photo}`}
                          data-lightbox-caption={`${expo.name} - Photo ${index + 1}`}
                        >
                          <img 
                            src={`${baseUrl}/expositions/${photo}`} 
                            alt={`${expo.name} exhibition photo ${index + 1}`}
                            class="expo-photo-grid"
                          />
                          <div class="zoom-overlay"></div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}
              
              <h3 class="expo-name">{expo.name}</h3>
              
              <div class="expo-detail">
                <span class="expo-detail-icon">📍</span>
                <span class="expo-detail-text">{expo.address}</span>
              </div>
              
              <div class="expo-detail">
                <span class="expo-detail-icon">📅</span>
                <span class="expo-detail-text">
                  <span class="expo-dates">
                    {formatDate(expo.startDate)} - {formatDate(expo.endDate)}
                  </span>
                </span>
              </div>
              
              {expo.website && (
                <a href={expo.website} target="_blank" rel="noopener noreferrer" class="expo-button">
                  Visit Website →
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    {pastExpositions.length > 0 && (
      <section class="expo-section">
        <h2 class="section-title">Past Expositions</h2>
        <div class="expo-grid">
          {pastExpositions.map((expo) => (
            <article class="expo-card">
              <span class="status-badge past">Past</span>
              
              {/* Photo Gallery */}
              {expo.photos && expo.photos.length > 0 && (
                <div class="expo-photos">
                  {expo.photos.length === 1 ? (
                    <div 
                      class="expo-photo-single js-lightbox-trigger"
                      data-lightbox-src={`${baseUrl}/expositions/${expo.photos[0]}`}
                      data-lightbox-caption={`${expo.name} - Exhibition Photo`}
                    >
                      <img 
                        src={`${baseUrl}/expositions/${expo.photos[0]}`} 
                        alt={`${expo.name} exhibition`}
                      />
                      <div class="zoom-overlay"></div>
                    </div>
                  ) : (
                    <div class={`expo-photo-gallery photos-${expo.photos.length}`}>
                      {expo.photos.map((photo, index) => (
                        <div 
                          class="expo-photo-wrapper js-lightbox-trigger"
                          data-lightbox-src={`${baseUrl}/expositions/${photo}`}
                          data-lightbox-caption={`${expo.name} - Photo ${index + 1}`}
                        >
                          <img 
                            src={`${baseUrl}/expositions/${photo}`} 
                            alt={`${expo.name} exhibition photo ${index + 1}`}
                            class="expo-photo-grid"
                          />
                          <div class="zoom-overlay"></div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}
              
              <h3 class="expo-name">{expo.name}</h3>
              
              <div class="expo-detail">
                <span class="expo-detail-icon">📍</span>
                <span class="expo-detail-text">{expo.address}</span>
              </div>
              
              <div class="expo-detail">
                <span class="expo-detail-icon">📅</span>
                <span class="expo-detail-text">
                  <span class="expo-dates">
                    {formatDate(expo.startDate)} - {formatDate(expo.endDate)}
                  </span>
                </span>
              </div>
              
              {expo.website && (
                <a href={expo.website} target="_blank" rel="noopener noreferrer" class="expo-button">
                  Visit Website →
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    {expositions.length === 0 && (
      <div class="empty-message">
        <p>No expositions scheduled at the moment. Check back soon!</p>
      </div>
    )}

  </main>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="lightbox">
    <span class="lightbox-close">&times;</span>
    <img class="lightbox-content" id="lightbox-image" alt="">
    <div class="lightbox-caption" id="lightbox-caption"></div>
  </div>

  <footer style="background: #2c3e50; color: white; text-align: center; padding: 2rem;">
    <p>&copy; 2026 Serra 2.0 Project. All rights reserved.</p>
  </footer>

  <script>
    const lightbox = document.getElementById('lightbox') as HTMLElement;
    const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption') as HTMLElement;
    const lightboxTriggers = document.querySelectorAll('.js-lightbox-trigger');

    function openLightbox(imageSrc: string, caption: string) {
      if (!lightbox || !lightboxImg || !lightboxCaption) return;
      lightbox.style.display = 'flex';
      lightboxImg.src = imageSrc;
      lightboxCaption.textContent = caption;
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.style.display = 'none';
      document.body.style.overflow = 'auto';
    }

    lightboxTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const imageSrc = (trigger as HTMLElement).dataset.lightboxSrc;
        const caption = (trigger as HTMLElement).dataset.lightboxCaption;
        if (imageSrc) {
          openLightbox(imageSrc, caption || '');
        }
      });
    });
    
    if (lightbox) {
      lightbox.addEventListener('click', () => {
        closeLightbox();
      });
    }

    if (lightboxImg) {
      lightboxImg.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
      });
    }

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeLightbox();
      }
    });
  </script>
</body>
</html>