---
// Artists Overview Page
// Displays all artists as compact cards that link to individual pages

import '../styles/global.css';
import Navigation from '../components/navbar.astro';
import ArtistCard from '../components/artist_card.astro';

// Page metadata
const pageTitle = "Artists - Serra 2.0";
const pageDescription = "Meet the talented artists behind the Serra 2.0 project";

// Base URL for GitHub Pages
const baseUrl = '/serra2';

// To add a new artist: add an object here with name, photo, and slug
// The slug should be URL-friendly (lowercase, hyphens instead of spaces)
const artists = [
  {
    name: "Amber-Rose Hulme",
    lastName: "Hulme",
    photo: `${baseUrl}/artists-artworks/AmberRose.jpg`,
    slug: "amber-rose-hulme"
  },
  {
    name: "Jesus Huanca",
    lastName: "Huanca",
    photo: `${baseUrl}/artists-artworks/JesusHuanca.jpg`,
    slug: "jesus-huanca"
  },
  {
    name: "Nathan Krieg",
    lastName : "Krieg",
    photo: `${baseUrl}/artists-artworks/NathanKrieg.jpg`,
    slug: "nathan-krieg"
  },
  {
    name: "István Bukovszki",
    lastName: "Bukovszki",
    photo: `${baseUrl}/artists-artworks/Istvan.jpg`,
    slug: "istvan-bukovszki"
  },
  {
    name: "Michele Braschi",
    lastName: "Braschi",
    photo: `${baseUrl}/artists-artworks/Braschi.jpg`,
    slug: "michele-braschi"
  },
  {
    name: "Anna Lachowska",
    lastName: "Lachoswka",
    photo: `${baseUrl}/artists-artworks/AnnaLachowska.jpg`,
    slug: "anna-lachowska"
  },
  {
    name: "Aleix Escura Bello",
    lastName: "Escura Bello",
    photo: `${baseUrl}/artists-artworks/Escura.jpg`,
    slug: "aleix-escura-bello"
  },
  {
    name: "Véronique Meignaud",
    lastName: "Meignaud",
    photo: `${baseUrl}/artists-artworks/Meignaud.jpg`,
    slug: "veronique-meignaud"
  },
  {
    name: "Hannes Versmissen",
    lastName: "Versmissen",
    photo: `${baseUrl}/artists-artworks/Hannes.jpg`,
    slug: "hannes-versmissen"
  },
  {
    name: "Eddie James",
    lastName: "James",
    photo: `${baseUrl}/artists-artworks/EddieJames.jpg`,
    slug: "eddie-james"
  },
  {
    name: "Johann Bodin",
    lastName: "Bodin",
    photo: `${baseUrl}/artists-artworks/Bodin.jpg`,
    slug: "johann-bodin"
  },
  {
    name: "Nicole Westbrook",
    lastName: "Westbrook",
    photo: `${baseUrl}/artists-artworks/NicoleWestbrook2.jpg`,
    slug: "nicole-westbrook"
  },
  {
    name: "Tommaso Giusti",
    lastName: "Giusti",
    photo: `${baseUrl}/artists-artworks/TommasoGiusti.jpg`,
    slug: "tommaso-giusti"
  },
].sort((a, b) => a.lastName.localeCompare(b.lastName));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <title>{pageTitle}</title>
</head>

<body>
  <Navigation currentPage="artists" />

  <header class="page-header">
    <h1>Featured Artists</h1>
    <p>Click on an artist to explore their work and learn more about their creative vision</p>
  </header>

  <main class="container">
    <div class="artists-compact-grid">
      {artists.map((artist) => (
        <ArtistCard 
          name={artist.name}
          photo={artist.photo}
          slug={artist.slug}
        />
      ))}
    </div>
  </main>

  <footer>
    <p>&copy; 2026 Serra 2.0 Project. All rights reserved.</p>
  </footer>
</body>
</html>