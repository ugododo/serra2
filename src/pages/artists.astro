---
// Artists Overview Page
// Displays all artists as compact cards that link to individual pages
// Place this file in: src/pages/artists.astro
// Styles are in src/styles/global.css

// Import components
import '../styles/global.css';
import Navigation from '../components/navbar.astro';
import ArtistCard from '../components/artist_card.astro';

// Page metadata
const pageTitle = "Artists - Serra 2.0";
const pageDescription = "Meet the talented artists behind the Serra 2.0 project";

// Artists data - Easy to maintain
// To add a new artist: add an object here with name, photo, and slug
// The slug should be URL-friendly (lowercase, hyphens instead of spaces)
const artists = [
  {
    name: "Amber Cartel",
    photo: "/artists-artworks/AmberCartel.jpg",
    slug: "amber-cartel"
  },
  {
    name: "Jesus Huenca",
    photo: "/artists-artworks/JesusHuenca.jpg",
    slug: "jesus-huenca"
  },
  {
    name: "Nathan Cartel",
    photo: "/artists-artworks/NathanCartel.jpg",
    slug: "nathan-cartel"
  },
  {
    name: "István Bukovszki",
    photo: "/artists-artworks/Istvan.jpg",
    slug: "istvan-bukovszki"
  },
  {
    name: "Michele Braschi",
    photo: "/artists-artworks/Braschi.jpg",
    slug: "michele-braschi"
  },
  {
    name: "Ann Cartel",
    photo: "/artists-artworks/AnnCartel.JPG",
    slug: "ann-cartel"
  },
  {
    name: "Aleix Escura Bello",
    photo: "/artists-artworks/Escura.JPG",
    slug: "aleix-escura-bello"
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <title>{pageTitle}</title>
</head>

<body>
  <!-- Import Navigation Component -->
  <Navigation currentPage="artists" />

  <!-- Page Header -->
  <header class="page-header">
    <h1>Featured Artists</h1>
    <p>Click on an artist to explore their work and learn more about their creative vision</p>
  </header>

  <!-- Main Content - Artists Grid -->
  <main class="container">
    <div class="artists-compact-grid">
      {artists.map((artist) => (
        <ArtistCard 
          name={artist.name}
          photo={artist.photo}
          slug={artist.slug}
        />
      ))}
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 Serra 2.0 Project. All rights reserved.</p>
  </footer>
</body>
</html>